CREATE TABLE usuario (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(150) UNIQUE NOT NULL,
    senha VARCHAR(255) NOT NULL,
    quantia_usuario DECIMAL(10,2) DEFAULT 0.00
);

CREATE TABLE meta_economia (
    id SERIAL PRIMARY KEY,
    id_usuario INTEGER NOT NULL REFERENCES usuario(id) ON DELETE CASCADE,
    descricao VARCHAR(255) NOT NULL,
    valor_objetivo DECIMAL(10,2) NOT NULL,
    valor_poupado DECIMAL(10,2) DEFAULT 0.00
);

CREATE TABLE gasto (
    id SERIAL PRIMARY KEY,
    id_usuario INTEGER NOT NULL REFERENCES usuario(id) ON DELETE CASCADE,
    descricao VARCHAR(255) NOT NULL,
    valor DECIMAL(10,2) NOT NULL,
    data_gasto DATE NOT NULL
);

CREATE TABLE grupo (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    descricao VARCHAR(255)
);

CREATE TABLE grupo_usuario (
    id_grupo INTEGER REFERENCES grupo(id) ON DELETE CASCADE,
    id_usuario INTEGER REFERENCES usuario(id) ON DELETE CASCADE,
    PRIMARY KEY (id_grupo, id_usuario)
);

CREATE TABLE amizade (
    id_usuario1 INTEGER REFERENCES usuario(id) ON DELETE CASCADE,
    id_usuario2 INTEGER REFERENCES usuario(id) ON DELETE CASCADE,
    PRIMARY KEY (id_usuario1, id_usuario2)
);